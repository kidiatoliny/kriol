// A molda larger than the stack limit can still be built straight into a
// global, and copied between globals, because neither needs a temporary.
molda Grandi {
    int[200000] v;
}

molda Par {
    Grandi a;
    int[200000] b;
}

Grandi global = Grandi{v = [3; 200000]};
Par par = Par{a = Grandi{v = [5; 200000]}, b = [7; 200000]};
int[200000] uns = [1; 200000];

fn inisiu() {
    global.v = uns;
    par.a = global;
    konfirma(par.a.v[199999] == 1 && par.b[0] == 7);
    mostran(global.v[0] + par.a.v[0] + par.b[199999]);
}
